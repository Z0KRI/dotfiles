/* ~/.config/rofi/config.rasi
 *
 * Rofi al estilo Spotlight.
 */

configuration {

    /* ---------------------------------------------------------------
     * LOS TRES CHIPS
     * ---------------------------------------------------------------
     * combi           -> la búsqueda general (ver combi-modes abajo)
     * recursivebrowser-> archivos, ya acotado
     * Clipboard    -> modo script sobre cliphist
     *
     * calc queda fuera: cada modo listado aquí dibuja un chip, y además
     * rofi-calc necesita el hook _preprocess_input, que combi nunca
     * invoca. Vive en su propia tecla, cuyo bind ya pasa -modes calc.
     *
     * Ruta ABSOLUTA: rofi no expande ~ dentro de este archivo.
     */
    modes: "combi,blocks,Clipboard:/home/zokri/.config/rofi/scripts/clipboard.sh";

    /* ---------------------------------------------------------------
     * LA LISTA ÚNICA (SUPER + SPACE)
     * ---------------------------------------------------------------
     * El orden importa, por tres motivos distintos:
     *
     * 1. "web" TIENE que ir primero. combi delega el texto que no
     *    coincide con nada al PRIMER modo de esta lista
     *    (source/modes/combi.c -> switchers[0]). Ese script no aporta
     *    ninguna entrada, solo captura URLs, comandos y búsquedas.
     *
     * 2. "window" antes que "drun" hace que escribir "Firefox" salte a
     *    la ventana ya abierta en vez de lanzar otra instancia.
     *
     * 3. "recursivebrowser" al final, o los archivos entierran a las apps.
     *
     * Ninguno de estos dibuja chip: los chips salen de "modes".
     */
    combi-modes: "web:~/.config/rofi/scripts/rofi_web.sh,window,drun,run";

    /* ---------------------------------------------------------------
     * ETIQUETAS
     * ---------------------------------------------------------------
     */
    combi-hide-mode-prefix: true;
    display-combi:            ""; /* glifo lucide: search / sparkles */
    display-blocks: ""; /* glifo lucide: folder */
    display-Clipboard:     ""; /* glifo lucide: clipboard */

    /* ---------------------------------------------------------------
     * BÚSQUEDA
     * ---------------------------------------------------------------
     * Difusa, como Spotlight: "vsc" encuentra "Visual Studio Code".
     */
    matching: "fuzzy";
    sorting-method: "fzf";
    sort: true;

    show-icons: true;
    drun-display-format: "{name}";
    drun-match-fields: "name,generic,exec,categories,keywords";

    terminal: "ghostty";

    /* Sin barra lateral: Spotlight no la tiene */
    sidebar-mode: false;

    /* ---------------------------------------------------------------
     * ARCHIVOS
     * ---------------------------------------------------------------
     * Este bloque es global al modo: el recursivebrowser del chip y el
     * de dentro de combi son el MISMO y comparten estos ajustes. No se
     * pueden configurar por separado.
     *
     * Y aquí está el coste de meterlo en combi: ahora el escaneo ocurre
     * en CADA pulsación de SUPER+SPACE, no solo al entrar al chip de
     * archivos. El filter-regex deja de ser opcional. Si notas retraso
     * al abrir, acota "directory" a ~/Projects.
     */

    show-icons: true;
    window-format: "{t:70}";

    window {
        prefer-icon-theme: true;
        fallback-icon: "application-x-executable";
    }
}

@theme "~/.config/rofi/spotlight.rasi"
